{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vp build",
        "build:ssr": "vp build && vp build --ssr",
        "dev": "vp dev",
        "lint": "vp fmt resources/ && vp lint --fix",
        "test:lint": "vp fmt --check resources/ && vp lint",
        "test:unit": "vitest run --coverage",
        "test:types": "vue-tsc --noEmit"
    },
    "dependencies": {
        "@inertiajs/vite": "^3.7.0",
        "@inertiajs/vue3": "^3.7.0",
        "@tailwindcss/vite": "^4.3.3",
        "@vitejs/plugin-vue": "^6.0.8",
        "concurrently": "^10.0.5",
        "laravel-vite-plugin": "^3.2.0",
        "tailwindcss": "^4.1.1",
        "typescript": "^5.9.3",
        "vite": "^8.2.2",
        "vue": "^3.5.42"
    },
    "devDependencies": {
        "@laravel/vite-plugin-wayfinder": "^0.1.10",
        "@testing-library/vue": "^8.1.0",
        "@types/node": "^24.13.3",
        "@vitest/coverage-v8": "^4.1.11",
        "jsdom": "^30.0.1",
        "playwright": "^1.63.0",
        "vite-plus": "0.3.0",
        "vitest": "^4.1.11",
        "vue-tsc": "^2.2.12"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.3",
        "@rollup/rollup-linux-x64-gnu": "4.63.1",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1"
    }
}
