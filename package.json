{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vp build",
        "build:ssr": "vp build && vp build --ssr",
        "dev": "vp dev",
        "lint": "vp fmt resources/ && vp lint --fix",
        "test:audit": "npm audit",
        "test:lint": "vp fmt --check resources/ && vp lint",
        "test:unit": "vitest run --coverage",
        "test:types": "vue-tsc --noEmit"
    },
    "dependencies": {
        "@inertiajs/vite": "^3.8.0",
        "@inertiajs/vue3": "^3.8.0",
        "@tailwindcss/vite": "^4.3.3",
        "@vitejs/plugin-vue": "^6.0.9",
        "concurrently": "^10.0.5",
        "laravel-vite-plugin": "^3.2.0",
        "tailwindcss": "^4.1.1",
        "typescript": "^5.9.3",
        "vite": "^8.3.3",
        "vue": "^3.5.43"
    },
    "devDependencies": {
        "@laravel/vite-plugin-wayfinder": "^0.1.10",
        "@testing-library/vue": "^8.1.0",
        "@types/node": "^26.6.4",
        "@vitest/coverage-v8": "^4.1.11",
        "jsdom": "^30.1.2",
        "playwright": "^1.63.0",
        "vite-plus": "0.3.0",
        "vitest": "^4.1.11",
        "vue-tsc": "^3.3.12"
    },
    "overrides": {
        "concurrently": {
            "shell-quote": "^1.11.0"
        },
        "oxfmt": {
            "tinypool": "^2.1.2"
        }
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.5",
        "@rollup/rollup-linux-x64-gnu": "4.63.1",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1"
    }
}
