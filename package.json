{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vp build",
        "build:ssr": "vp build && vp build --ssr",
        "dev": "vp dev",
        "lint": "vp fmt resources/ && vp lint --fix",
        "test:audit": "npm audit",
        "test:lint": "vp fmt --check resources/ && vp lint",
        "test:unit": "vitest run --coverage",
        "test:types": "vue-tsc --noEmit"
    },
    "dependencies": {
        "@inertiajs/vue3": "^3.9.1",
        "vue": "^3.5.44"
    },
    "devDependencies": {
        "@inertiajs/vite": "^3.9.1",
        "@laravel/vite-plugin-wayfinder": "^0.1.10",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/vue": "^8.1.0",
        "@types/node": "^26.6.5",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vitest/coverage-v8": "5.0.3",
        "concurrently": "^10.0.6",
        "jsdom": "^30.1.2",
        "laravel-vite-plugin": "^3.2.0",
        "playwright": "^1.64.0",
        "tailwindcss": "^4.1.1",
        "typescript": "^5.9.3",
        "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
        "vite-plus": "1.1.0",
        "vitest": "5.0.3",
        "vue-tsc": "^3.3.13"
    },
    "overrides": {
        "concurrently": {
            "shell-quote": "^1.11.0"
        },
        "vite": "$vite",
        "vitest": "$vitest"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1"
    }
}
